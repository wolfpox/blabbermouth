; Engine configuration file.

config_version=5

[application]

config/name="Blabbermouth"
config/description="Text-to-mumble voice engine for Godot."
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://addons/blabbermouth/icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/blabbermouth/plugin.cfg")
