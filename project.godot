; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Blabbermouth"
config/description="Text-to-mumble voice engine for Godot."
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.11, 0.12, 0.15, 1)
boot_splash/show_image=false
config/icon="res://addons/blabbermouth/icon.svg"

[audio]

general/default_playback_type.web=0
driver/output_latency.web=80
driver/enable_input=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/blabbermouth/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
